#!/usr/bin/env bash
# Launch the vLLM backend that serves Midnight City agents (OmegaClaw talks to this).
#
# Model: nvidia/Qwen3-32B-FP4 - DENSE 32B, NVFP4, GQA with 8 KV heads. ~18GB of
# weights. Swapped in from the 35B-A3B MoE because that model has only ~3B ACTIVE
# parameters: with thinking off it was doing a five-branch conditional procedure on
# a 3B forward pass and failing it. A dense 32B spends ~10x the compute per token
# in the forward pass, so it needs no chain-of-thought tax to reason.
#
# ALIAS: always served as `mcity-agent` as well as its real name. OmegaClaw asks for
# the alias, so swapping the model here never requires touching the agent launcher.
#
#
# TOOL CALLING: this model emits XML-style calls
#   <tool_call><function=NAME><parameter=KEY>value</parameter></function></tool_call>
# per its chat template, so the parser is qwen3_xml - NOT hermes (hermes expects JSON
# inside <tool_call>). Without --enable-auto-tool-choice the API rejects tool_choice
# "auto" outright, and without --reasoning-parser the model's <think> chain-of-thought
# lands in message.content and breaks OmegaClaw's parsing.
#
# THINKING IS OFF BY DEFAULT, via --default-chat-template-kwargs. This is the single
# biggest lever on agent responsiveness, measured on this box:
#
#   identical prompt, thinking ON : 33.7s, 351 completion tokens
#   identical prompt, thinking OFF:  0.6s,   5 completion tokens
#
# Both produced a valid s-expression. With thinking on, the live agent generated
# continuously at ~11 tok/s and took about three minutes per decision - roughly two
# thousand tokens of silent deliberation to emit one command. Midnight City moves in
# real time and people wait in threads, so a three-minute turn is not a slow agent, it
# is an absent one. The dense 32B was chosen precisely so it would not need the
# chain-of-thought tax to reason (see above), and it does not.
#
# --default-chat-template-kwargs is preferred over the older approach of passing
# --chat-template at a hand-edited copy of the template with the default inverted:
# no vendored template file to drift from the model, and callers can still opt back
# in per request with "chat_template_kwargs": {"enable_thinking": true}.
#
# --reasoning-parser qwen3 is SAFE alongside this and is kept. The earlier
# content=null failure came from the vendored-template approach: the stream never
# contained a closing </think>, so the parser filed every reply as reasoning and the
# agent looked mute while producing good text. Verified with the flag as it now
# stands: enable_thinking false returns content='(continue-action)' and empty
# reasoning, so nothing is swallowed. Tool calling is unaffected either way.
#
# MEMORY DISCIPLINE - do not raise these casually. The DGX Spark GB10 has 119.69 GiB
# of UNIFIED memory shared between CPU and GPU. --gpu-memory-utilization is a fraction
# of that TOTAL, not of some separate VRAM pool. On 2026-08-09 this container ran at
# 0.85 (101.7 GiB) serving the 122B and repeatedly triggered system-wide OOM cascades
# that killed gnome-shell, NetworkManager, containerd and the whole desktop session.
# 0.42 = 50.3 GiB, which leaves ~69 GiB for the OS and the nexus-* containers.
# Higher than the MoE needed: this model keeps a real KV cache on all 64 layers,
# where the MoE kept one on only 10 of 40.
set -euo pipefail

NAME="${VLLM_NAME:-vllm-mcity}"
IMAGE="${VLLM_IMAGE:-vllm/vllm-openai:latest}"
MODEL="${VLLM_MODEL:-nvidia/Qwen3-32B-FP4}"
PORT="${VLLM_PORT:-8000}"
GPU_UTIL="${VLLM_GPU_UTIL:-0.42}"
MAX_LEN="${VLLM_MAX_LEN:-32768}"
MAX_SEQS="${VLLM_MAX_SEQS:-4}"
# Kept from the MoE config: harmless here (this model has standard attention, so the
# Mamba align-mode floor does not apply) and it keeps chunked prefill chunks large.
MAX_BATCHED="${VLLM_MAX_BATCHED:-4096}"
# Hard cgroup backstop so a runaway allocation can never take the machine down again.
MEM_LIMIT="${VLLM_MEM_LIMIT:-56g}"

docker rm -f "$NAME" >/dev/null 2>&1 || true

docker run -d \
  --name "$NAME" \
  --restart unless-stopped \
  --gpus all \
  --memory "$MEM_LIMIT" \
  --shm-size 8g \
  --log-opt max-size=50m --log-opt max-file=3 \
  --publish "${PORT}:8000" \
  --volume /home/gomiex/models:/models \
  --volume /home/gomiex/.cache/huggingface:/root/.cache/huggingface \
  --env HF_HUB_OFFLINE=1 \
  "$IMAGE" \
  "$MODEL" \
  --served-model-name "$MODEL" mcity-agent \
  --host 0.0.0.0 --port 8000 \
  --gpu-memory-utilization "$GPU_UTIL" \
  --max-model-len "$MAX_LEN" \
  --max-num-seqs "$MAX_SEQS" \
  --max-num-batched-tokens "$MAX_BATCHED" \
  --reasoning-parser qwen3 \
  --default-chat-template-kwargs '{"enable_thinking": false}' \
  --enable-auto-tool-choice \
  --tool-call-parser hermes \
  --kv-cache-dtype fp8 \
  --enable-prefix-caching \
  --enable-chunked-prefill \
  --trust-remote-code >/dev/null

echo "$NAME starting (model=$MODEL util=$GPU_UTIL port=$PORT mem-cap=$MEM_LIMIT)"
echo "logs:   docker logs -f $NAME"
echo "ready:  curl -s localhost:${PORT}/v1/models"
