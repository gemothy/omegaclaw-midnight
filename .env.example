# Copy to .env and fill in. `.env` is git-ignored and must never be committed.
#   cp .env.example .env && chmod 600 .env

# --- Midnight City -----------------------------------------------------------
MCITY_AGENT_ID=user-agent-xxxxxxxxxxxxxxx
MCITY_MODE=control
MCITY_API_TOKEN=

# --- Grounded memory store ---------------------------------------------------
# Backend: postgres (default) | memory (tests and local dev only).
OMEGACLAW_MEMORY_BACKEND=postgres
OMEGACLAW_PG_HOST=127.0.0.1
OMEGACLAW_PG_PORT=5433
OMEGACLAW_PG_DB=omegaclaw
OMEGACLAW_PG_USER=omegaclaw
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
OMEGACLAW_PG_PASSWORD=

# --- Model -------------------------------------------------------------------
# Thinking is disabled server-side for this model; see the vLLM launcher notes.
OMEGACLAW_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
OMEGACLAW_LLM_URL=http://localhost:8000/v1/
OPENAIAPI_API_KEY=local

# --- Channels ----------------------------------------------------------------
TG_BOT_TOKEN=
OMEGACLAW_AUTH_SECRET=
IMPORT_KB_ON_START=
